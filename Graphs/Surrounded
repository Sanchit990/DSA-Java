package Graphs;
import java.util.*;
class Solution {
    public void solve(char[][] board) {
        int m=board.length;
        int n=board[0].length;
        Queue<int[]>q=new LinkedList<>();
        for(int i=0;i<m;i++){
                if(board[i][0]=='O'){
                    board[i][0]='%';
                    q.offer(new int[]{i,0});
                }
                if(board[i][n-1]=='O'){
                    board[i][n-1]='%';
                    q.offer(new int[]{i,n-1});
                }
        }
        for(int j=0;j<n;j++){
            if(board[0][j]=='O'){
                    board[0][j]='%';
                    q.offer(new int[]{0,j});
                }
                if(board[m-1][j]=='O'){
                    board[m-1][j]='%';//indicates % is a safe block and cant be converted
                    q.offer(new int[]{m-1,j});
                }
        }
        while(!q.isEmpty()){
            int[]i=q.poll();
            int a=i[0];
            int b=i[1];
            if(a+1 < m && board[a+1][b] == 'O'){
        board[a+1][b] = '%';
        q.offer(new int[]{a+1,b});
    }

    if(a-1 >= 0 && board[a-1][b] == 'O'){
        board[a-1][b] = '%';
        q.offer(new int[]{a-1,b});
    }

    if(b+1 < n && board[a][b+1] == 'O'){
        board[a][b+1] = '%';
        q.offer(new int[]{a,b+1});
    }

    if(b-1 >= 0 && board[a][b-1] == 'O'){
        board[a][b-1] = '%';
        q.offer(new int[]{a,b-1});
    }
        }
        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
                if(board[i][j]=='%')
                board[i][j]='O';
                else 
                board[i][j]='X';
            }
        }
    }
}